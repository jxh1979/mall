{
  "name": "apps-customer-app",
  "private": true,
  "version": "0.1.0",
  "documentVersion": "V0.02",
  "description": "官方客人 App（Android/iPhone）的客人专用构建入口：只含客人代码，本地打包页面资源。",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "npm run typecheck && vite build",
    "build:android-debug": "npm run typecheck && vite build --mode android-debug",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --host 0.0.0.0 --port 5174",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@ant-design/v5-patch-for-react-19": "1.0.3",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/action-sheet": "8.1.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3",
    "@complex/customer-core": "0.1.0",
    "antd": "^5.22.5",
    "dayjs": "^1.11.21",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
