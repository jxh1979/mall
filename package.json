{
  "name": "entertainment-complex-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "node tools/run-backend-maven.mjs spring-boot:run",
    "test:backend": "node tools/run-backend-maven.mjs test",
    "verify:backend-env": "node tools/run-backend-maven.mjs --check",
    "dev:api": "npm run dev:backend",
    "dev:web": "npm run dev --workspace apps/web",
    "verify:openapi": "node tools/verify-openapi-contract.mjs",
    "audit:client-routes": "node tools/audit-client-api-routes.mjs",
    "verify:client-routes": "node tools/audit-client-api-routes.mjs --strict",
    "audit:client-openapi": "node tools/audit-client-openapi-coverage.mjs",
    "verify:client-openapi": "node tools/audit-client-openapi-coverage.mjs --strict",
    "audit:client-payload": "node tools/verify-client-payload-policy.mjs",
    "verify:client-payload": "node tools/verify-client-payload-policy.mjs --strict",
    "docs:repair-openapi-text": "node tools/repair-openapi-human-text.mjs",
    "docs:openapi-examples": "node tools/apply-openapi-p0-examples.mjs",
    "verify:openapi-examples": "node tools/verify-openapi-p0-examples.mjs",
    "docs:operation-matrix": "node tools/generate-openapi-operation-matrix.mjs",
    "verify:operation-matrix": "node tools/generate-openapi-operation-matrix.mjs --check",
    "docs:openapi-closure": "node tools/generate-openapi-contract-closure-appendix.mjs",
    "verify:openapi-closure": "node tools/generate-openapi-contract-closure-appendix.mjs --check",
    "docs:security-baseline": "node tools/generate-formal-security-baseline.mjs",
    "verify:security-baseline": "npm run verify:prod-docs-access && node tools/verify-formal-security-baseline.mjs --strict",
    "verify:prod-docs-access": "node tools/verify-prod-docs-access-policy.mjs",
    "verify:ops160-execution-policy": "node tools/verify-ops160-execution-policy.mjs",
    "verify:ops160-backup-restore": "node tools/verify-160-backup-restore-scripts.mjs",
    "verify:production-credentials": "node tools/verify-production-credential-rotation-ledger.mjs",
    "verify:p0a-ops-hardening": "node tools/verify-p0a-ops-hardening.mjs",
    "verify:ops160-recovery": "npm run verify:coding-host-protection && npm run verify:ops160-execution-policy && npm run verify:ops160-backup-restore && npm run verify:production-credentials && npm run verify:p0a-ops-hardening",
    "verify:p0-contract": "npm run verify:no-legacy-api-prototype && npm run verify:openapi && npm run verify:openapi-examples && npm run verify:operation-matrix && npm run verify:openapi-closure && npm run verify:client-routes && npm run verify:client-openapi && npm run verify:client-payload",
    "verify:p0-web": "npm run verify:p0-contract && npm run build",
    "verify:p0-env": "npm run verify:backend-env && npm run verify:android-env",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "smoke:p0": "npm run test:backend",
    "smoke:p0-ops": "npm run test:backend",
    "verify:android-env": "node tools/run-android-gradle.mjs --check --require-android-sdk --project apps/android-terminal/android-app",
    "android:p0:build": "node tools/run-android-gradle.mjs --project apps/android-terminal clean build",
    "android:p0:smoke": "node tools/run-android-gradle.mjs --project apps/android-terminal run",
    "android:p0:apk": "node tools/run-android-gradle.mjs --project apps/android-terminal/android-app --require-android-sdk :app:assembleDebug",
    "verify:p0": "npm run verify:coding-host-protection && npm run verify:p0-contract && npm run verify:security-baseline && npm run test:backend && npm run build && npm run verify:android-env && npm run android:p0:build && npm run android:p0:smoke && npm run android:p0:apk",
    "verify:no-legacy-api-prototype": "node tools/verify-no-legacy-api-prototype.mjs",
    "verify:coding-host-protection": "node tools/verify-coding-host-protection.mjs",
    "verify:t3-coding-package": "node tools/verify-t3-coding-package.mjs",
    "verify:t3a-readonly-analytics": "node tools/verify-t3a-readonly-analytics.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
