# 160 API runtime env template.
# Copy required keys into /etc/complex/complex.env and fill secrets from the credential ledger.
# Do not commit real passwords or production secrets.

SPRING_PROFILES_ACTIVE=dev
COMPLEX_API_PORT=8080
COMPLEX_API_HOST=127.0.0.1

COMPLEX_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/complex
COMPLEX_DATABASE_NAME=complex
COMPLEX_DATABASE_USERNAME=<fill-from-credential-ledger>
COMPLEX_DATABASE_PASSWORD=<fill-from-credential-ledger>
COMPLEX_DATABASE_POOL_SIZE=10
COMPLEX_DATABASE_MIN_IDLE=2

COMPLEX_MINIO_ENDPOINT=http://127.0.0.1:9000
COMPLEX_MINIO_ACCESS_KEY=<fill-from-credential-ledger>
COMPLEX_MINIO_SECRET_KEY=<fill-from-credential-ledger>
COMPLEX_REDIS_URL=redis://127.0.0.1:6379
COMPLEX_NATS_URL=nats://127.0.0.1:4222

COMPLEX_API_VERSION=0.1.0
COMPLEX_API_BUILD_TIME=local

# NAS backup target.
# 192.168.88.113 is the NAS server. Mount it on 160 first, then point NAS_BACKUP_TARGET_DIR to the mounted directory.
NAS_BACKUP_HOST=192.168.88.113
NAS_BACKUP_SHARE=bn
NAS_BACKUP_UNC=//192.168.88.113/bn
NAS_BACKUP_TARGET_DIR=/mnt/complex-nas-backup
NAS_BACKUP_RETENTION_DAYS=30
NAS_BACKUP_CAPACITY_LIMIT=1TB
NAS_BACKUP_CREDENTIAL_REF=cred://prod/nas/smb/complex-backup-rw
REQUIRE_NAS_BACKUP_SYNC=true

# Current production decision (2026-07-04, user-confirmed): ENCRYPT backup archives.
# Backups contain customer/finance/credential data; AES-256 via passphrase
# (~/.complex/backup.passphrase), restore drill auto-decrypts. Keep this false so the
# encryption guard stays active (set true ONLY to deliberately allow plaintext, and then
# also remove the passphrase file).
ALLOW_UNENCRYPTED_BACKUPS=false

# Reserved only if backup encryption is enabled later.
NAS_BACKUP_KEY_REF=cred://prod/nas/backup-encryption-key

JWT_SECRET=<fill-at-least-32-random-characters>
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_TTL_SECONDS=900
USER_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_FAILURE_LOCK_THRESHOLD=3

# Android P0 smoke test account.
# Use a seeded low-privilege P0 test admin account only; never use a real production administrator password.
P0_API_BASE_URL=http://127.0.0.1:8080
P0_ADMIN_USERNAME=<seeded-p0-smoke-admin>
P0_ADMIN_PASSWORD=<fill-from-credential-ledger>
